# --- Nebius Token Factory (get a key: https://dev.nebius.com/builders) ---
NEBIUS_API_KEY=
# OpenAI-compatible base URL (Token Factory). Override only if your dashboard shows another.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs: list what YOUR key can reach with:  GET $NEBIUS_BASE_URL/models
# Example known-good IDs (verify against your key):
#   nvidia/nemotron-3-super-120b-a12b
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b

# --- Tavily (web search; optional but recommended) ---
TAVILY_API_KEY=

# Embedding model for semantic memory (pick from GET $NEBIUS_BASE_URL/models).
# Leave empty to use keyword search only (works offline).
NEBIUS_EMBEDDING_MODEL=

# Optional per-1M-token prices (USD) for the cost meter — copy from Token Factory pricing.
NEBIUS_PRICE_INPUT_PER_1M=
NEBIUS_PRICE_OUTPUT_PER_1M=

# Proactive memory: extract durable facts into long-term memory after each turn (1 = on).
YAAD_AUTO_REMEMBER=1

# --- Server ---
PORT=8787
MEMORY_DIR=~/.yaad
SKILLS_DIR=./skills
