{
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "description": "Yaad server \u2014 personal AI agent on NVIDIA Nemotron via Nebius Token Factory.",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "name": "yaad-server",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild src/mcp.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "mcp": "node dist/mcp.js",
    "eval": "tsx eval/memory.eval.ts"
  },
  "type": "module",
  "version": "0.1.0"
}