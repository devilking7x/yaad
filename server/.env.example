# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Model IDs your key can reach — verify with:
# curl -H "Authorization: Bearer $NEBIUS_API_KEY" https://api.tokenfactory.nebius.com/v1/models
#
# Recommended NVIDIA Nemotron 3 lineup (Token Factory, 2026):
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B        # fast routing, tool calls, extraction
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b       # deep reasoning, planning
NEBIUS_VISION_MODEL=nvidia/Nemotron-3-Nano-Omni                # photo memory (multimodal)
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B                 # semantic memory recall

# Tavily (https://tavily.com) — web search + deep research
TAVILY_API_KEY=

# Optional
YAAD_AUTO_REMEMBER=1              # background fact extraction after each turn
YAAD_API_TOKEN=                   # shared bearer token for the public demo
CORS_ORIGIN=https://devilking7x.github.io
YAAD_DAILY_CAP_USD=2              # daily spend guard (USD, IST day)
NEBIUS_PRICE_INPUT_PER_1M=        # for the cost meter (depends on your models)
NEBIUS_PRICE_OUTPUT_PER_1M=
